{
  "name": "@chaosity/location-client",
  "version": "0.5.1",
  "description": "Client library for Chaosity Location Service with AWS Location Service compatibility",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "aws",
    "location",
    "maps",
    "geocoding",
    "maplibre",
    "places"
  ],
  "author": "Chaosity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaosity-io/location-service-client.git"
  },
  "homepage": "https://github.com/chaosity-io/location-service-client",
  "bugs": {
    "url": "https://github.com/chaosity-io/location-service-client/issues"
  },
  "dependencies": {
    "@aws-sdk/client-geo-places": "^3.0.0",
    "@aws/amazon-location-utilities-datatypes": "^1.0.0",
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.1.0",
    "husky": "^9.0.0",
    "maplibre-gl": "^5.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
